{
  "name": "skucoverage-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute skucoverage-prod --file=schema.sql",
    "build:app": "npm --prefix skufrontend/app run build && cp -R skufrontend/app/dist/. cloudflare-pages/app/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.91.0"
  }
}
